# =====================================================================
# Solid Mini Growth Engine — contoh konfigurasi environment
# Salin menjadi .env lalu isi nilai yang sesuai. JANGAN commit file .env.
# =====================================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smge_dev?schema=public
# Dipakai oleh integration test (database terpisah, akan di-reset saat test)
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/smge_test?schema=public

# --- Redis (BullMQ, cache) ---
REDIS_URL=redis://127.0.0.1:6379

# --- API (NestJS) ---
API_PORT=4000
# Origin dashboard yang diizinkan (CORS). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGINS=http://localhost:3000
# URL publik dashboard, dipakai untuk link reset password
APP_PUBLIC_URL=http://localhost:3000
# URL halaman registrasi / landing Solid Mini (placeholder {{link}} di template pesan; UTM ditambahkan otomatis)
SOLID_MINI_REGISTRATION_URL=

# --- Autentikasi ---
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# true di produksi (HTTPS). false hanya untuk development lokal via http.
COOKIE_SECURE=false
# Batas percobaan login sebelum akun dikunci sementara
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Enkripsi data sensitif (token integrasi, secret 2FA) ---
# 32 byte dalam base64. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Email (opsional; jika kosong, link reset password hanya ditulis ke log server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SMGE <no-reply@example.com>"

# --- Seed awal ---
SEED_SUPERADMIN_EMAIL=superadmin@smge.local
SEED_SUPERADMIN_PASSWORD=GantiSegera!2026

# --- AI (Fase 3) ---
# Kosong = otomatis (openai bila OPENAI_API_KEY terisi, selain itu AI nonaktif).
# "simulated" = keluaran simulasi berlabel SIMULASI untuk mencoba UI tanpa API key. Jangan dipakai di produksi.
AI_PROVIDER=
OPENAI_API_KEY=
# Nama model yang tersedia di akun OpenAI Anda (bisa diganti dari halaman Pengaturan AI)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_TIMEOUT_MS=30000
THROTTLE_AI_LIMIT_PER_MINUTE=30

# --- Integrasi TikTok (Fase 4) — isi hanya setelah aplikasi disetujui TikTok ---
# Dari developers.tiktok.com → Manage apps (produk Login Kit). Redirect URI wajib https & terdaftar:
#   https://<domain>/api/integrations/tiktok/callback
# Webhook (portal TikTok) arahkan ke: https://<domain>/api/webhooks/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats
# true = gunakan Mock Adapter (data simulasi, selalu diberi label SIMULASI)
# Development saja; ditolak bila NODE_ENV=production
TIKTOK_USE_MOCK=false

# --- Tracking konversi (Fase 5) ---
# Secret HMAC yang dibagikan dengan backend Solid Mini untuk Conversion API (min. 32 karakter).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVERSION_API_SECRET=
# Origin landing page yang mengirim event dari browser, mis. https://solidmini.example
TRACKING_ALLOWED_ORIGINS=
ATTRIBUTION_LOOKBACK_DAYS=30
THROTTLE_TRACKING_LIMIT_PER_MINUTE=120

# --- Dashboard (Next.js) ---
# URL internal API yang dipakai proxy Next.js (server-side)
API_INTERNAL_URL=http://127.0.0.1:4000
