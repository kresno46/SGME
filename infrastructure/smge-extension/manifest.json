{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SMGE Toolkit",
  "version": "1.0.3",
  "description": "Ambil followers dan kirim DM dengan mesin DM Sender v0.2.8.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SMGE Toolkit",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "version_name": "1.0.3 (DM Sender 0.2.8)"
}
