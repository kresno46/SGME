{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SMGE Browser DM Sender",
  "version": "0.2.3",
  "description": "Kirim tugas DM yang disetujui dari antrean SMGE melalui browser TikTok.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "debugger"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" }
}
